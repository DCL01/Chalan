<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4B0082">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Catálogo de Productos"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Tabla de Productos -->
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:layout_marginBottom="16dp">

            <!-- Encabezados de la Tabla -->
            <TableRow>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nombre"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:padding="8dp"
                    android:textColor="#000000" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Descripción"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:padding="8dp"
                    android:textColor="#000000" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Acción"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:padding="8dp"
                    android:textColor="#000000" />
            </TableRow>

            <!-- Fila de Producto Ejemplo -->
            <TableRow>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Producto 1"
                    android:padding="8dp"
                    android:textColor="#000000" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Descripción del producto 1"
                    android:padding="8dp"
                    android:textColor="#000000" />

                <Button
                    android:id="@+id/buttonVerProducto1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#FF8C00"
                    android:textColor="#FFFFFF"
                    android:text="Ver"
                    android:padding="8dp" />
            </TableRow>

            <!-- Añadir más filas de productos similares aquí -->

        </TableLayout>

        <!-- Botón para Regresar al Menú Home -->
        <Button
            android:id="@+id/buttonRegresarHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#800080"
            android:textColor="#FFFFFF"
            android:text="Regresar al Menú Home"
            android:padding="16dp"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
